# Normalize source files across Windows, macOS and Linux.
* text=auto
*.js text eol=lf
*.cjs text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.svg text eol=lf
*.xml text eol=lf
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
